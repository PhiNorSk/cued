{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cued",
  "version": "1.0.1",
  "identifier": "app.cued.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cued",
        "visible": false,
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0C0F0D"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https://i.scdn.co",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https://i.scdn.co",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 170, "y": 195 },
        "applicationFolderPosition": { "x": 490, "y": 195 }
      }
    }
  }
}
